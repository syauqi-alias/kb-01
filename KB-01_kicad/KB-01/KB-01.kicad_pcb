		(knockout no)
	)
	(gr_text_box "track_widths (quick-pick list, Route toolbar / hotkey W)\n  0.0  → {dblquote}use netclass{dblquote} (KiCad's default entry)\n  0.15 mm  ~0.8 A   fine-pitch digital signal\n  0.20 mm  ~1.0 A   standard digital signal (matches Default netclass)\n  0.255 mm          (already there - SE_50_Inner_Near, impedance-driven)\n  0.30 mm  ~1.4 A   low-current control/logic power\n  0.395 mm          (already there - SE_50_Outer, impedance-driven)\n  0.50 mm  ~2.0 A   sensor/peripheral VDD rails\n  0.75 mm  ~2.7 A   LDO outputs, charger control rails\n  1.00 mm  ~3.3 A   CM5 5V feed branch, BQ25895 SYS branch\n  1.50 mm  ~4.4 A   boost converter in/out near TPS61022's 8A valley limit\n  2.00 mm  ~5.4 A   main 5V bus trunk (boost → CM5)\n  3.00 mm  ~7.3 A   battery (BAT+) trunk / VBUS trunk at connector\n\nvia_dimensions (quick-pick list, same toolbar)\n  0.0 / 0.0     → {dblquote}use netclass{dblquote}\n  0.6 / 0.3 mm  → existing Default netclass via (signal)\n  0.8 / 0.4 mm  → light power via\n  1.0 / 0.5 mm  → medium power via\n  1.2 / 0.6 mm  → heavy power via (battery/5V trunk, or use several in parallel)"
		(start -136.8 22.8)
		(end -3.95 108.1687)
